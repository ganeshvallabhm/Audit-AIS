# CompanyAudit Backend Environment Template
# Copy to backend/.env and replace all placeholders before starting.

ENVIRONMENT=development
APP_NAME=CompanyAudit Enterprise API
API_PREFIX=/api

# PostgreSQL connection strings (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://companyaudit:replace_with_strong_local_db_password@localhost:5433/companyaudit
TEST_DATABASE_URL=postgresql+psycopg://companyaudit:replace_with_strong_local_db_password@localhost:5433/companyaudit_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_generated_64_char_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Strict CORS origins (comma-separated; never use '*' in staging/production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Secure Evidence Storage (outside web root)
EVIDENCE_STORAGE_DIR=./storage/evidence
MAX_EVIDENCE_BYTES=26214400

# Demo seed switch (must be false and COOKIE_SECURE=true in staging/production)
ALLOW_DEMO_SEED=true
DEMO_ACCOUNT_PASSWORD=replace_with_dev_seed_password
COOKIE_SECURE=false

# Optional external AI provider (leave blank for deterministic PostgreSQL telemetry synthesis)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Telemetry & Operational Automation
SENTRY_DSN=
ENABLE_BACKGROUND_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=900
RATE_LIMIT_ENABLED=true
