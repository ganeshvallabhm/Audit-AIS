# Frontend API configuration
# By default Vite proxies /api to http://127.0.0.1:8000 (see vite.config.ts)
VITE_API_BASE_URL=/api

# PostgreSQL Compose Variables (root docker-compose.yml & docker-compose.prod.yml)
POSTGRES_USER=companyaudit
POSTGRES_PASSWORD=replace_with_strong_local_db_password
POSTGRES_DB=companyaudit
POSTGRES_PORT=5433
FRONTEND_PORT=8080

# Production Compose Overrides
ENVIRONMENT=production
JWT_SECRET_KEY=replace_with_generated_64_char_secret_key
CORS_ORIGINS=https://companyaudit.local
COOKIE_SECURE=true
